<%- include('../partials/header') %>
<section class="py-5" style="background:var(--green-bg)">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="form-card">
          <h3 class="section-title mb-1"><i class="fas fa-plus me-2"></i>Add New Plant Listing</h3>
          <div class="section-divider mb-4"></div>
          <form action="/seller/add-listing" method="POST" enctype="multipart/form-data">
            <div class="row g-3">
              <div class="col-12"><label class="form-label">Plant Title *</label><input type="text" name="title" class="form-control" placeholder="e.g. Beautiful Monstera Deliciosa" required/></div>
              <div class="col-12"><label class="form-label">Description *</label><textarea name="description" class="form-control" rows="4" placeholder="Describe the plant, its size, age, health condition..." required></textarea></div>
              <div class="col-sm-6"><label class="form-label">Price (Rs.) *</label><input type="number" name="price" class="form-control" min="1" placeholder="500" required/></div>
              <div class="col-sm-6"><label class="form-label">Stock Quantity *</label><input type="number" name="stock" class="form-control" min="1" value="1" required/></div>
              <div class="col-sm-6"><label class="form-label">Category</label><select name="category" class="form-select"><% ['indoor','outdoor','succulents','flowering','herbs','trees','aquatic','other'].forEach(c=>{%><option value="<%= c %>"><%= c.charAt(0).toUpperCase()+c.slice(1) %></option><%})%></select></div>
              <div class="col-sm-6"><label class="form-label">Care Level</label><select name="careLevel" class="form-select"><option value="easy">Easy</option><option value="moderate">Moderate</option><option value="expert">Expert</option></select></div>
              <div class="col-sm-6"><label class="form-label">Sunlight</label><select name="sunlight" class="form-select"><option value="low">Low / Shade</option><option value="medium">Medium / Indirect</option><option value="high">High / Full Sun</option></select></div>
              <div class="col-sm-6"><label class="form-label">Watering</label><select name="watering" class="form-select"><option value="daily">Daily</option><option value="every2days">Every 2 Days</option><option value="weekly">Weekly</option><option value="biweekly">Bi-Weekly</option></select></div>
              <div class="col-sm-6"><label class="form-label">City</label><select name="city" class="form-select"><% ['Lahore','Karachi','Islamabad','Rawalpindi','Faisalabad','Multan','Peshawar','Quetta','Sialkot','Gujranwala'].forEach(c=>{%><option value="<%= c %>"><%= c %></option><%})%></select></div>
              <div class="col-sm-6"><label class="form-label">Area / Locality</label><input type="text" name="area" class="form-control" placeholder="e.g. DHA, Gulberg"/></div>
              <div class="col-12"><label class="form-label">Tags (comma separated)</label><input type="text" name="tags" class="form-control" placeholder="rare, air-purifying, pet-safe"/></div>
              <div class="col-12"><label class="form-label">Plant Images (up to 5)</label><input type="file" name="images" class="form-control" multiple accept="image/*"/><small class="text-muted">First image will be the main display image.</small></div>
            </div>
            <div class="d-flex gap-3 mt-4">
              <button type="submit" class="btn-primary btn btn-lg"><i class="fas fa-plus me-2"></i>Create Listing</button>
              <a href="/seller/listings" class="btn btn-outline-secondary btn-lg" style="border-radius:25px">Cancel</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
