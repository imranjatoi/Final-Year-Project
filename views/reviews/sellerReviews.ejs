<%- include('../partials/header') %>
<section class="py-5">
  <div class="container">
    <h2 class="section-title mb-4"><i class="fas fa-star me-2"></i>Seller Reviews</h2>
    <% if(reviews.length === 0){ %>
    <div class="empty-state"><div class="empty-icon">⭐</div><h5>No reviews yet</h5></div>
    <% } else { %>
    <div class="row g-3">
      <% reviews.forEach(r => { %>
      <div class="col-md-6">
        <div style="background:white;border-radius:var(--radius);box-shadow:var(--shadow);padding:1.5rem">
          <div class="d-flex align-items-center gap-3 mb-3">
            <img src="<%= (r.buyer && r.buyer.avatar) || '/images/default-avatar.png'||'/images/default-avatar.png' %>" style="width:44px;height:44px;border-radius:50%;object-fit:cover"/>
            <div>
              <div style="font-weight:600"><%= (r.buyer && r.buyer.name) || '' %></div>
              <div style="font-size:.75rem;color:var(--text-light)"><%= new Date(r.createdAt).toLocaleDateString('en-PK',{year:'numeric',month:'long',day:'numeric'}) %></div>
            </div>
            <div class="ms-auto stars"><% for(let i=1;i<=5;i++){%><i class="fas fa-star" style="color:<%=i<=r.overallRating?'#FFB300':'#ddd'%>"></i><%}%></div>
          </div>
          <div class="d-flex gap-3 mb-3" style="font-size:.8rem">
            <div>Seller <div class="stars-sm"><% for(let i=1;i<=5;i++){%><i class="fas fa-star" style="color:<%=i<=r.sellerRating?'#FFB300':'#ddd'%>"></i><%}%></div></div>
            <div>Plant <div class="stars-sm"><% for(let i=1;i<=5;i++){%><i class="fas fa-star" style="color:<%=i<=r.plantConditionRating?'#FFB300':'#ddd'%>"></i><%}%></div></div>
            <div>Packaging <div class="stars-sm"><% for(let i=1;i<=5;i++){%><i class="fas fa-star" style="color:<%=i<=r.packagingRating?'#FFB300':'#ddd'%>"></i><%}%></div></div>
          </div>
          <% if(r.comment){ %><p style="font-size:.88rem;color:var(--text-mid);margin:0;font-style:italic">"<%= r.comment %>"</p><% } %>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>
  </div>
</section>
<%- include('../partials/footer') %>
