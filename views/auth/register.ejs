<%- include('../partials/header') %>
<section class="py-5 min-vh-100 d-flex align-items-center" style="background:var(--green-bg)">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-7">
        <div class="form-card">
          <div class="text-center mb-4">
            <div style="font-size:3rem">🌱</div>
            <h2 class="section-title">Create Account</h2>
            <!-- Role toggle -->
            <div class="d-flex justify-content-center gap-3 mt-3" id="roleToggle">
              <button type="button" class="btn btn-outline-success role-btn <%=role==='buyer'?'active':''%>" data-role="buyer" style="border-radius:25px;font-weight:600;padding:.4rem 1.5rem">
                <i class="fas fa-user me-2"></i>Join as Buyer
              </button>
              <button type="button" class="btn btn-outline-warning role-btn <%=role==='seller'?'active':''%>" data-role="seller" style="border-radius:25px;font-weight:600;padding:.4rem 1.5rem">
                <i class="fas fa-store me-2"></i>Join as Seller
              </button>
            </div>
          </div>
          <form action="/auth/register" method="POST">
            <input type="hidden" name="role" id="roleInput" value="<%= role %>"/>
            <div class="row g-3">
              <div class="col-sm-6">
                <label class="form-label">Full Name</label>
                <input type="text" name="name" class="form-control" placeholder="Ahmed Ali" required/>
              </div>
              <div class="col-sm-6">
                <label class="form-label">Email Address</label>
                <input type="email" name="email" class="form-control" placeholder="you@example.com" required/>
              </div>
              <div class="col-sm-6">
                <label class="form-label">Phone Number</label>
                <input type="tel" name="phone" class="form-control" placeholder="0300-1234567"/>
              </div>
              <div class="col-sm-6">
                <label class="form-label">City</label>
                <select name="city" class="form-select">
                  <option value="">Select City</option>
                  <% ['Lahore','Karachi','Islamabad','Rawalpindi','Faisalabad','Multan','Peshawar','Quetta','Sialkot','Gujranwala'].forEach(c=>{ %>
                  <option value="<%= c %>"><%= c %></option>
                  <% }) %>
                </select>
              </div>
              <!-- Seller fields -->
              <div id="sellerFields" style="display:<%=role==='seller'?'contents':'none'%>">
                <div class="col-12">
                  <label class="form-label">Business / Nursery Name</label>
                  <input type="text" name="businessName" class="form-control" placeholder="Your nursery or business name"/>
                </div>
                <div class="col-12">
                  <label class="form-label">Describe your plants / business</label>
                  <textarea name="sellerDescription" class="form-control" rows="2" placeholder="Tell buyers what you sell and your experience..."></textarea>
                </div>
              </div>
              <div class="col-sm-6">
                <label class="form-label">Password</label>
                <input type="password" name="password" class="form-control" placeholder="Min 8 characters" minlength="8" required/>
              </div>
              <div class="col-sm-6">
                <label class="form-label">Confirm Password</label>
                <input type="password" id="confirmPass" class="form-control" placeholder="Repeat password" required/>
              </div>
            </div>
            <div id="sellerNote" style="display:<%=role==='seller'?'block':'none'%>" class="mt-3">
              <div style="background:#FFF8E1;border-radius:var(--radius-sm);padding:.9rem;font-size:.85rem;color:#F57F17;border-left:3px solid #FFB300">
                <i class="fas fa-info-circle me-2"></i>Seller accounts require admin verification before you can list plants. This usually takes 1–2 business days.
              </div>
            </div>
            <button type="submit" class="btn-primary btn w-100 btn-lg mt-4">Create Account <i class="fas fa-arrow-right ms-2"></i></button>
          </form>
          <div class="text-center mt-3" style="font-size:.9rem">
            Already have an account? <a href="/auth/login" style="color:var(--green-main);font-weight:600">Login here</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  const roleInput = document.getElementById('roleInput');
  const sellerFields = document.getElementById('sellerFields');
  const sellerNote   = document.getElementById('sellerNote');
  document.querySelectorAll('.role-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.role-btn').forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      const r = this.dataset.role;
      roleInput.value = r;
      sellerFields.style.display = r === 'seller' ? 'contents' : 'none';
      sellerNote.style.display   = r === 'seller' ? 'block' : 'none';
    });
  });
  document.querySelector('form').addEventListener('submit', function(e) {
    const p1 = document.querySelector('[name="password"]').value;
    const p2 = document.getElementById('confirmPass').value;
    if (p1 !== p2) { e.preventDefault(); alert('Passwords do not match.'); }
  });
</script>
<%- include('../partials/footer') %>
