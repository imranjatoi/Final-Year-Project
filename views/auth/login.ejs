<%- include('../partials/header') %>
<section class="py-5 min-vh-100 d-flex align-items-center" style="background:var(--green-bg)">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-5">
        <div class="form-card">
          <div class="text-center mb-4">
            <div style="font-size:3rem">🌿</div>
            <h2 class="section-title">Welcome Back</h2>
            <p style="color:var(--text-light);font-size:.9rem">Login to your Baghban account</p>
          </div>
          <form action="/auth/login" method="POST">
            <div class="mb-3">
              <label class="form-label">Email Address</label>
              <input type="email" name="email" class="form-control" placeholder="you@example.com" required/>
            </div>
            <div class="mb-4">
              <label class="form-label">Password</label>
              <input type="password" name="password" class="form-control" placeholder="Your password" required/>
            </div>
            <button type="submit" class="btn-primary btn w-100 btn-lg">Login <i class="fas fa-arrow-right ms-2"></i></button>
          </form>
          <hr class="my-4"/>
          <div class="text-center" style="font-size:.9rem">
            <p class="mb-2">Don't have an account? <a href="/auth/register" class="fw-600" style="color:var(--green-main)">Register as Buyer</a></p>
            <p class="mb-0">Want to sell plants? <a href="/auth/register?role=seller" style="color:var(--accent)">Register as Seller</a></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
