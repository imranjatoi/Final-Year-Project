<%- include('../partials/header') %>
<section class="py-5 min-vh-100 d-flex align-items-center" style="background:var(--green-bg)">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-5">
        <div class="form-card">
          <% if (typeof resetLink !== 'undefined' && resetLink) { %>
            <!-- Success State with Direct Reset Button -->
            <div class="text-center mb-4">
              <div style="font-size:3rem">✉️</div>
              <h2 class="section-title">Link Generated!</h2>
              <p style="color:var(--text-light);font-size:.9rem">
                Password reset link for <strong><%= typeof userEmail !== 'undefined' ? userEmail : '' %></strong> is ready.
              </p>
            </div>
            <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
              <i class="fas fa-check-circle me-2 fs-5"></i>
              <div style="font-size:0.9rem;">
                Click the button below to set your new password.
              </div>
            </div>
            <a href="<%= resetLink %>" class="btn-primary btn w-100 btn-lg text-center d-block mb-3">
              Set New Password <i class="fas fa-arrow-right ms-2"></i>
            </a>
            <hr class="my-4"/>
            <div class="text-center" style="font-size:.9rem">
              <p class="mb-0"><a href="/auth/login" class="fw-600" style="color:var(--green-main)">Back to Login</a></p>
            </div>
          <% } else { %>
            <!-- Request Form -->
            <div class="text-center mb-4">
              <div style="font-size:3rem">🔒</div>
              <h2 class="section-title">Forgot Password?</h2>
              <p style="color:var(--text-light);font-size:.9rem">Enter your registered email and we'll send you a password reset link.</p>
            </div>
            <form action="/auth/forgot-password" method="POST">
              <div class="mb-4">
                <label class="form-label">Email Address</label>
                <input type="email" name="email" class="form-control" placeholder="you@example.com" required autofocus/>
              </div>
              <button type="submit" class="btn-primary btn w-100 btn-lg">Send Reset Link <i class="fas fa-paper-plane ms-2"></i></button>
            </form>
            <hr class="my-4"/>
            <div class="text-center" style="font-size:.9rem">
              <p class="mb-0">Remember your password? <a href="/auth/login" class="fw-600" style="color:var(--green-main)">Back to Login</a></p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
