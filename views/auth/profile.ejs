<%- include('../partials/header') %>
<section class="py-5" style="background:var(--green-bg)">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-8">
        <div class="form-card">
          <div class="d-flex align-items-center gap-4 mb-4">
            <img src="<%= user.avatar||'/images/default-avatar.png' %>" alt="" style="width:80px;height:80px;border-radius:50%;object-fit:cover;border:3px solid var(--green-pale)"/>
            <div>
              <h3 class="section-title mb-0"><%= user.name %></h3>
              <span class="badge-category text-capitalize"><%= user.role %></span>
              <% if(user.role==='seller'){ %>
              <span class="ms-2 <%=user.isVerified?'badge-verified':'badge-pending'%>">
                <i class="fas fa-<%=user.isVerified?'check-circle':'clock'%> me-1"></i><%= user.verificationStatus %>
              </span>
              <% } %>
            </div>
          </div>
          <form action="/auth/profile" method="POST" enctype="multipart/form-data">
            <div class="row g-3">
              <div class="col-sm-6">
                <label class="form-label">Full Name</label>
                <input type="text" name="name" value="<%= user.name %>" class="form-control" required/>
              </div>
              <div class="col-sm-6">
                <label class="form-label">Email</label>
                <input type="email" value="<%= user.email %>" class="form-control" disabled/>
              </div>
              <div class="col-sm-6">
                <label class="form-label">Phone</label>
                <input type="tel" name="phone" value="<%= user.phone||'' %>" class="form-control"/>
              </div>
              <div class="col-sm-6">
                <label class="form-label">City</label>
                <select name="city" class="form-select">
                  <% ['Lahore','Karachi','Islamabad','Rawalpindi','Faisalabad','Multan','Peshawar','Quetta','Sialkot','Gujranwala'].forEach(c=>{ %>
                  <option value="<%= c %>" <%=user.city===c?'selected':''%>><%= c %></option>
                  <% }) %>
                </select>
              </div>
              <div class="col-12">
                <label class="form-label">Address</label>
                <input type="text" name="address" value="<%= user.address||'' %>" class="form-control" placeholder="Your delivery address"/>
              </div>
              <div class="col-12">
                <label class="form-label">Profile Photo</label>
                <input type="file" name="avatar" class="form-control" accept="image/*"/>
              </div>
            </div>
            <button type="submit" class="btn-primary btn mt-4">Save Changes</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
