<%- include('../partials/header') %>
<section class="py-5">
  <div class="container">
    <h2 class="section-title mb-1"><i class="fas fa-box me-2"></i>My Orders</h2>
    <div class="section-divider mb-4"></div>
    <% if(orders.length === 0){ %>
    <div class="empty-state"><div class="empty-icon">📦</div><h5>No orders yet</h5><p>Browse plants and place your first order!</p><a href="/plants" class="btn-primary btn mt-2">Browse Plants</a></div>
    <% } else { %>
    <div class="row g-3">
      <% orders.forEach(order => { %>
      <div class="col-12">
        <div style="background:var(--white);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden">
          <div style="background:var(--green-bg);padding:1rem 1.5rem;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.5rem">
            <div>
              <span style="font-size:.78rem;color:var(--text-light)">ORDER</span>
              <span style="font-weight:700;color:var(--green-dark);margin-left:.4rem">#<%= order._id.toString().slice(-8).toUpperCase() %></span>
              <span class="ms-3" style="font-size:.82rem;color:var(--text-light)"><%= new Date(order.createdAt).toLocaleDateString('en-PK',{year:'numeric',month:'short',day:'numeric'}) %></span>
            </div>
            <span class="order-status-badge status-badge-<%= order.status %>"><%= order.status.toUpperCase() %></span>
          </div>
          <div class="p-4">
            <div class="d-flex gap-4 align-items-start flex-wrap">
              <img src="<%= (order.listing && order.listing.images && order.listing.images[0]) ? order.listing.images[0] : '/images/plants/default-plant.jpg' %>" alt="" style="width:80px;height:80px;border-radius:var(--radius-sm);object-fit:cover"/>
              <div class="flex-grow-1">
                <h6 class="mb-1"><%= order.listing && order.listing.title || 'Plant' || 'Plant' %></h6>
                <div style="font-size:.85rem;color:var(--text-light)">
                  <i class="fas fa-store me-1"></i><%= (order.seller && (order.seller.businessName || order.seller.name)) || '' %>
                  <span class="ms-3"><i class="fas fa-map-marker-alt me-1"></i><%= (order.seller && order.seller.city) || '' %></span>
                </div>
                <div class="mt-2" style="font-size:.88rem">
                  <span>Qty: <strong><%= order.quantity %></strong></span>
                  <span class="ms-3">Total: <strong style="color:var(--green-main)">Rs. <%= order.totalPrice ? order.totalPrice.toLocaleString() : '0' %></strong></span>
                  <span class="ms-3"><%= order.deliveryType === 'delivery' ? '🚚 Home Delivery' : '🏪 Self Pickup' %></span>
                </div>
              </div>
              <div class="d-flex flex-column gap-2">
                <a href="/orders/<%= order._id %>" class="btn-sm-green" style="text-align:center">View Details</a>
                <% if(order.status === 'delivered' && !order.reviewSubmitted){ %>
                <a href="/orders/<%= order._id %>#review" class="btn btn-warning btn-sm" style="border-radius:20px;font-size:.8rem">Write Review</a>
                <% } %>
                <% if(['placed','confirmed'].includes(order.status)){ %>
                <form action="/orders/<%= order._id %>/cancel" method="POST" class="confirm-delete">
                  <button type="submit" class="btn btn-outline-danger btn-sm w-100" style="border-radius:20px;font-size:.8rem">Cancel</button>
                </form>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>
  </div>
</section>
<%- include('../partials/footer') %>
