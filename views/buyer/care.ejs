<%- include('../partials/header') %>
<section class="py-5">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
      <div>
        <h2 class="section-title mb-1"><i class="fas fa-seedling me-2"></i>Plant Care Tracker</h2>
        <div class="section-divider"></div>
      </div>
      <button class="btn-primary btn" data-bs-toggle="modal" data-bs-target="#addPlantModal"><i class="fas fa-plus me-2"></i>Add Plant</button>
    </div>

    <% if(entries.length === 0){ %>
    <div class="empty-state"><div class="empty-icon">🪴</div><h5>No plants in your tracker</h5><p>Add your first plant to start getting care reminders.</p><button class="btn-primary btn mt-2" data-bs-toggle="modal" data-bs-target="#addPlantModal">Add a Plant</button></div>
    <% } else { %>
    <div class="row g-4">
      <% entries.forEach(entry => { %>
      <% const diff = entry.daysUntilWatering; %>
      <% const pct = entry.progressPct; %>
      <% const status = entry.wateringStatus; %>
      <div class="col-sm-6 col-lg-4">
        <div class="care-card">
          <img src="<%= entry.image || '/images/plants/care-default.jpg' %>" alt="<%= entry.plantName %>"/>
          <div class="p-3">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div>
                <h6 class="mb-0"><%= entry.plantName %></h6>
                <% if(entry.plantType){ %><small style="color:var(--text-light)"><%= entry.plantType %></small><% } %>
              </div>
              <span class="care-status-<%= status %>">
                <%= status === 'ok' ? '✅ On Track' : status === 'soon' ? '⚡ Due Soon' : status === 'today' ? '💧 Water Today' : '🚨 Overdue' %>
              </span>
            </div>

            <div class="care-progress mb-2">
              <div class="care-progress-bar" data-progress="<%= pct %>"></div>
            </div>

            <div style="font-size:.8rem;color:var(--text-light)" class="mb-3">
              <div class="d-flex justify-content-between">
                <span><i class="fas fa-calendar-alt me-1"></i>Next: <strong style="color:<%= status==='overdue'?'#C62828':status==='today'?'#E65100':'var(--green-main)' %>"><%= diff < 0 ? Math.abs(diff)+' days ago' : diff === 0 ? 'Today!' : 'In '+diff+' days' %></strong></span>
                <span><i class="fas fa-tint me-1"></i>Every <%= entry.wateringFrequencyDays %> days</span>
              </div>
              <div class="mt-1">
                <i class="fas fa-sun me-1"></i>Sunlight: <%= entry.sunlightNeeds %>
                <span class="ms-3"><i class="fas fa-calendar me-1"></i>Last: <%= new Date(entry.lastWateredDate).toLocaleDateString('en-PK',{month:'short',day:'numeric'}) %></span>
              </div>
            </div>

            <div class="d-flex gap-2">
              <form action="/care/<%= entry._id %>/watered" method="POST" class="flex-grow-1">
                <button type="submit" class="btn btn-success btn-sm w-100" style="border-radius:20px"><i class="fas fa-tint me-1"></i>Mark Watered</button>
              </form>
              <form action="/care/<%= entry._id %>/delete" method="POST" class="confirm-delete">
                <button type="submit" class="btn btn-outline-danger btn-sm" style="border-radius:20px"><i class="fas fa-trash"></i></button>
              </form>
            </div>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>
  </div>
</section>

<!-- Add Plant Modal -->
<div class="modal fade" id="addPlantModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content" style="border-radius:var(--radius)">
      <div class="modal-header" style="background:var(--green-main);color:white;border-radius:var(--radius) var(--radius) 0 0">
        <h5 class="modal-title"><i class="fas fa-plus me-2"></i>Add Plant to Tracker</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form action="/care/add" method="POST" enctype="multipart/form-data">
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-sm-6">
              <label class="form-label">Plant Name *</label>
              <input type="text" name="plantName" class="form-control" placeholder="e.g. My Monstera" required/>
            </div>
            <div class="col-sm-6">
              <label class="form-label">Plant Type</label>
              <input type="text" name="plantType" class="form-control" placeholder="e.g. Monstera Deliciosa"/>
            </div>
            <div class="col-sm-6">
              <label class="form-label">Watering Every (days) *</label>
              <input type="number" name="wateringFrequencyDays" class="form-control" min="1" max="90" placeholder="e.g. 3" required/>
            </div>
            <div class="col-sm-6">
              <label class="form-label">Last Watered Date *</label>
              <input type="date" name="lastWateredDate" class="form-control" required value="<%= new Date().toISOString().split('T')[0] %>"/>
            </div>
            <div class="col-sm-6">
              <label class="form-label">Sunlight Needs</label>
              <select name="sunlightNeeds" class="form-select">
                <option value="low">Low – Shade-loving</option>
                <option value="medium" selected>Medium – Indirect light</option>
                <option value="high">High – Full sun</option>
              </select>
            </div>
            <div class="col-sm-6">
              <label class="form-label">Fertilize Every (days)</label>
              <input type="number" name="fertilizingDays" class="form-control" value="30" min="7"/>
            </div>
            <div class="col-12">
              <label class="form-label">Plant Photo</label>
              <input type="file" name="image" class="form-control" accept="image/*"/>
            </div>
            <div class="col-12">
              <label class="form-label">Notes</label>
              <textarea name="notes" class="form-control" rows="2" placeholder="Any special care notes..."></textarea>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn-primary btn"><i class="fas fa-plus me-2"></i>Add to Tracker</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
