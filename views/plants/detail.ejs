<%- include('../partials/header') %>

<section class="py-5">
  <div class="container">
    <nav aria-label="breadcrumb" class="mb-4">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item"><a href="/plants">Plants</a></li>
        <li class="breadcrumb-item active"><%= plant.title %></li>
      </ol>
    </nav>

    <div class="row g-5">
      <!-- ── Gallery ── -->
      <div class="col-lg-6">
        <div class="detail-gallery mb-3">
          <img id="mainImage" src="<%= plant.images[0] || '/images/plants/default-plant.jpg' %>" alt="<%= plant.title %>"/>
        </div>
        <% if(plant.images.length > 1){ %>
        <div class="d-flex gap-2 flex-wrap">
          <% plant.images.forEach((img,i) => { %>
          <img src="<%= img %>" class="detail-thumb <%=i===0?'active':''%>" data-src="<%= img %>" alt="thumbnail"/>
          <% }) %>
        </div>
        <% } %>
      </div>

      <!-- ── Details ── -->
      <div class="col-lg-6">
        <div class="d-flex gap-2 flex-wrap mb-3">
          <span class="badge-category"><%= plant.category %></span>
          <% if(plant.seller.isVerified){%><span class="badge-verified"><i class="fas fa-check-circle"></i> Verified Seller</span><%}%>
          <span class="badge bg-light text-muted" style="border-radius:20px"><i class="fas fa-eye me-1"></i><%= plant.views %> views</span>
        </div>

        <h1 style="font-size:1.8rem;color:var(--green-dark)" class="mb-2"><%= plant.title %></h1>
        <div class="plant-card-price mb-3" style="font-size:2rem">Rs. <%= plant.price.toLocaleString() %></div>

        <p style="color:var(--text-mid);line-height:1.8" class="mb-4"><%= plant.description %></p>

        <!-- Care tags -->
        <div class="d-flex flex-wrap gap-2 mb-4">
          <span class="care-tag"><i class="fas fa-sun text-warning"></i> Sunlight: <%= plant.sunlight %></span>
          <span class="care-tag"><i class="fas fa-tint text-primary"></i> Watering: <%= plant.watering.replace('every2days','Every 2 Days') %></span>
          <span class="care-tag"><i class="fas fa-seedling text-success"></i> Care: <%= plant.careLevel %></span>
          <% if(plant.stock > 0){ %>
          <span class="care-tag"><i class="fas fa-boxes"></i> Stock: <%= plant.stock %></span>
          <% } else { %>
          <span style="background:#FFEBEE;color:#C62828;border-radius:20px;padding:.3rem .85rem;font-size:.83rem;font-weight:600">Out of Stock</span>
          <% } %>
        </div>

        <!-- Order form -->
        <% if(currentUser && currentUser.role === 'buyer' && plant.isAvailable && plant.stock > 0){ %>
        <div class="form-card mb-3">
          <form action="/orders/place" method="POST">
            <input type="hidden" name="listingId" value="<%= plant._id %>"/>
            <input type="hidden" name="plantPrice" id="plantPrice" data-price="<%= plant.price %>"/>
            <div class="row g-3 mb-3">
              <div class="col-sm-4">
                <label class="form-label">Quantity</label>
                <div class="d-flex align-items-center gap-2">
                  <button type="button" id="qtyMinus" class="btn btn-outline-secondary btn-sm" style="border-radius:50%;width:30px;height:30px;padding:0">−</button>
                  <input type="number" id="qtyInput" name="quantity" value="1" min="1" max="<%= plant.stock %>" class="form-control text-center" style="width:60px"/>
                  <button type="button" id="qtyPlus" class="btn btn-outline-secondary btn-sm" style="border-radius:50%;width:30px;height:30px;padding:0">+</button>
                </div>
              </div>
              <div class="col-sm-8">
                <label class="form-label">Delivery Type</label>
                <select name="deliveryType" class="form-select">
                  <option value="delivery">Home Delivery</option>
                  <option value="pickup">Self Pickup</option>
                </select>
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label">Delivery Address</label>
              <input type="text" name="deliveryAddress" class="form-control" placeholder="Your full delivery address" value="<%= (currentUser && currentUser.address)||'' %>"/>
            </div>
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <span style="font-size:.85rem;color:var(--text-light)">Total:</span>
                <span id="totalPrice" style="font-size:1.3rem;font-weight:700;color:var(--green-main);margin-left:.5rem">Rs. <%= plant.price.toLocaleString() %></span>
              </div>
              <button type="submit" class="btn-primary btn btn-lg"><i class="fas fa-shopping-cart me-2"></i>Place Order</button>
            </div>
          </form>
        </div>
        <% } else if(!currentUser){ %>
        <div style="background:var(--green-bg);border-radius:var(--radius);padding:1.2rem;text-align:center">
          <p class="mb-2">Please login to place an order</p>
          <a href="/auth/login" class="btn-primary btn">Login to Order</a>
        </div>
        <% } else if(currentUser.role === 'seller'){ %>
        <div style="background:#FFF8E1;border-radius:var(--radius);padding:1rem;font-size:.9rem;color:#F57F17"><i class="fas fa-info-circle me-2"></i>Sellers cannot place orders. Switch to a buyer account.</div>
        <% } %>
      </div>
    </div>

    <!-- ── Seller Card ── -->
    <div class="row mt-5 g-4">
      <div class="col-lg-4">
        <div class="seller-card">
          <div class="d-flex align-items-center gap-3 mb-3">
            <img src="<%= plant.seller.avatar || '/images/default-avatar.png' %>" alt="" style="width:56px;height:56px;border-radius:50%;object-fit:cover;border:3px solid var(--green-pale)"/>
            <div>
              <h6 class="mb-0"><%= plant.seller.businessName || plant.seller.name %></h6>
              <% if(plant.seller.isVerified){%><span class="badge-verified"><i class="fas fa-check-circle"></i> Verified</span><%}%>
            </div>
          </div>
          <div style="font-size:.88rem;color:var(--text-mid);line-height:2">
            <div><i class="fas fa-map-marker-alt me-2 text-green"></i><%= plant.seller.city %></div>
            <% if(plant.seller.phone){ %><div><i class="fas fa-phone me-2 text-green"></i><%= plant.seller.phone %></div><% } %>
            <% if(plant.seller.averageRating>0){ %>
            <div class="stars-sm mt-1">
              <% for(let i=1;i<=5;i++){%><i class="fas fa-star<%=i<=Math.round(plant.seller.averageRating)?'':' text-muted'%>" style="<%=i<=Math.round(plant.seller.averageRating)?'color:#FFB300':'color:#ddd'%>"></i><%}%>
              <span style="font-size:.8rem;color:var(--text-light)"><%= plant.seller.averageRating %> (<%= plant.seller.totalReviews %> reviews)</span>
            </div>
            <% } %>
          </div>
          <% if(plant.seller.sellerDescription){ %>
          <p style="font-size:.82rem;color:var(--text-light);margin-top:.7rem;border-top:1px solid var(--border);padding-top:.7rem"><%= plant.seller.sellerDescription %></p>
          <% } %>
          <a href="/reviews/seller/<%= plant.seller._id %>" class="btn btn-outline-success btn-sm mt-2 w-100">View All Reviews</a>
        </div>
      </div>

      <!-- ── Reviews ── -->
      <div class="col-lg-8">
        <h4 class="section-title mb-3">Customer Reviews</h4>
        <% if(reviews.length === 0){ %>
        <div class="empty-state" style="padding:2rem"><div class="empty-icon" style="font-size:2.5rem">⭐</div><p>No reviews yet for this seller.</p></div>
        <% } else { %>
        <% reviews.forEach(r => { %>
        <div class="mb-3" style="background:var(--white);border-radius:var(--radius);padding:1.2rem;box-shadow:var(--shadow)">
          <div class="d-flex align-items-center gap-3 mb-2">
            <img src="<%= r.buyer.avatar||'/images/default-avatar.png' %>" alt="" style="width:38px;height:38px;border-radius:50%;object-fit:cover"/>
            <div>
              <div style="font-weight:600;font-size:.9rem"><%= r.buyer.name %></div>
              <div class="stars-sm"><% for(let i=1;i<=5;i++){%><i class="fas fa-star" style="color:<%=i<=r.sellerRating?'#FFB300':'#ddd'%>"></i><%}%></div>
            </div>
            <div class="ms-auto" style="font-size:.78rem;color:var(--text-light)"><%= new Date(r.createdAt).toLocaleDateString('en-PK',{year:'numeric',month:'short',day:'numeric'}) %></div>
          </div>
          <div class="d-flex gap-3 mb-2" style="font-size:.78rem">
            <span style="color:var(--text-mid)">Plant Condition: <span class="stars-sm"><% for(let i=1;i<=5;i++){%><i class="fas fa-star" style="color:<%=i<=r.plantConditionRating?'#FFB300':'#ddd'%>"></i><%}%></span></span>
            <span style="color:var(--text-mid)">Packaging: <span class="stars-sm"><% for(let i=1;i<=5;i++){%><i class="fas fa-star" style="color:<%=i<=r.packagingRating?'#FFB300':'#ddd'%>"></i><%}%></span></span>
          </div>
          <% if(r.comment){ %><p style="font-size:.88rem;color:var(--text-mid);margin:0">"<%= r.comment %>"</p><% } %>
        </div>
        <% }) %>
        <% } %>
      </div>
    </div>

    <!-- ── Related Plants ── -->
    <% if(related.length > 0){ %>
    <div class="mt-5">
      <h4 class="section-title mb-4">You May Also Like</h4>
      <div class="row g-3">
        <% related.forEach(p => { %>
        <div class="col-6 col-md-3">
          <div class="plant-card">
            <a href="/plants/<%= p._id %>"><img src="<%= p.images[0]||'/images/plants/default-plant.jpg' %>" alt="<%= p.title %>" style="height:160px"/></a>
            <div class="plant-card-body">
              <h6 class="plant-card-title"><a href="/plants/<%= p._id %>" style="color:inherit;text-decoration:none"><%= p.title %></a></h6>
              <div class="d-flex justify-content-between align-items-center">
                <span class="plant-card-price" style="font-size:1rem">Rs. <%= p.price.toLocaleString() %></span>
                <a href="/plants/<%= p._id %>" class="btn-sm-green">View</a>
              </div>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
    <% } %>
  </div>
</section>

<%- include('../partials/footer') %>
