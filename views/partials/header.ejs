<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title || 'Baghban' %></title>
  <link rel="icon" href="/images/favicon.png" type="image/png"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet"/>
  <link href="/css/style.css" rel="stylesheet"/>
</head>
<body>

<!-- ── Navbar ── -->
<nav class="navbar navbar-expand-lg">
  <div class="container">
    <a class="navbar-brand" href="/"><i class="fas fa-leaf me-2"></i>Bagh<span>ban</span></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navMenu">
      <ul class="navbar-nav me-auto gap-1">
        <li class="nav-item"><a class="nav-link" href="/plants"><i class="fas fa-store me-1"></i>Browse Plants</a></li>
        <% if (currentUser && currentUser.role === 'buyer') { %>
        <li class="nav-item"><a class="nav-link" href="/orders"><i class="fas fa-box me-1"></i>My Orders</a></li>
        <li class="nav-item"><a class="nav-link" href="/care"><i class="fas fa-seedling me-1"></i>Plant Care</a></li>
        <% } %>
        <% if (currentUser && currentUser.role === 'seller') { %>
        <li class="nav-item"><a class="nav-link" href="/seller/dashboard"><i class="fas fa-chart-line me-1"></i>Dashboard</a></li>
        <li class="nav-item"><a class="nav-link" href="/seller/listings"><i class="fas fa-list me-1"></i>My Listings</a></li>
        <li class="nav-item"><a class="nav-link" href="/seller/orders"><i class="fas fa-clipboard-list me-1"></i>Orders</a></li>
        <% } %>
        <% if (currentUser && currentUser.role === 'admin') { %>
        <li class="nav-item"><a class="nav-link" href="/admin/dashboard"><i class="fas fa-shield-alt me-1"></i>Admin</a></li>
        <% } %>
      </ul>
      <ul class="navbar-nav gap-2 align-items-center">
        <% if (!currentUser) { %>
        <li class="nav-item"><a class="nav-link" href="/auth/login">Login</a></li>
        <li class="nav-item"><a class="nav-link btn-nav-cta" href="/auth/register">Join Free</a></li>
        <% } else { %>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" data-bs-toggle="dropdown">
            <img src="<%= currentUser.avatar || '/images/default-avatar.png' %>" alt="" style="width:30px;height:30px;border-radius:50%;object-fit:cover;border:2px solid rgba(255,255,255,.5)"/>
            <%= currentUser.name.split(' ')[0] %>
          </a>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" href="/auth/profile"><i class="fas fa-user me-2 text-green"></i>Profile</a></li>
            <% if (currentUser.role === 'buyer') { %>
            <li><a class="dropdown-item" href="/orders"><i class="fas fa-box me-2 text-green"></i>My Orders</a></li>
            <li><a class="dropdown-item" href="/care"><i class="fas fa-seedling me-2 text-green"></i>Plant Care</a></li>
            <% } %>
            <li><hr class="dropdown-divider"/></li>
            <li><a class="dropdown-item text-danger" href="/auth/logout"><i class="fas fa-sign-out-alt me-2"></i>Logout</a></li>
          </ul>
        </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>

<!-- ── Flash messages ── -->
<div class="container mt-3">
  <% if (success && success.length > 0) { %>
    <% success.forEach(msg => { %>
    <div class="flash-success"><i class="fas fa-check-circle"></i> <%- msg %></div>
    <% }) %>
  <% } %>
  <% if (error && error.length > 0) { %>
    <% error.forEach(msg => { %>
    <div class="flash-error"><i class="fas fa-exclamation-circle"></i> <%- msg %></div>
    <% }) %>
  <% } %>
</div>
